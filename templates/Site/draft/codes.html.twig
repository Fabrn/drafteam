{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        input {
            width: 100%;
        }
    </style>
{% endblock %}

{% block body %}
    <h1>{{ 'draft.create.codes.title' | trans }}</h1>

    <div>
        <label for="blue_team_uuid">{{ 'draft.create.codes.blue' | trans }}</label>
        <input type="text" id="blue_team_uuid" name="blue_team_uuid" readonly
               value="{{ absolute_url(path('draft_view', { identifier: draft.identifier, role: draft.blueTeamUuid, _locale: app.request.locale })) }}" />
    </div>

    <div>
        <label for="red_team_uuid">{{ 'draft.create.codes.red' | trans }}</label>
        <input type="text" id="red_team_uuid" name="red_team_uuid" readonly
               value="{{ absolute_url(path('draft_view', { identifier: draft.identifier, role: draft.redTeamUuid, _locale: app.request.locale })) }}" />
    </div>

    <div>
        <label for="spectator_uuid">{{ 'draft.create.codes.spectator' | trans }}</label>
        <input type="text" id="spectator_uuid" name="spectator_uuid" readonly
               value="{{ absolute_url(path('draft_view', { identifier: draft.identifier, role: draft.spectatorUuid, _locale: app.request.locale })) }}" />
    </div>
{% endblock %}
