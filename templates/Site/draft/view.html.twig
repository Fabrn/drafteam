{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        [name="champion_grid_item"]:checked + img {
            filter: brightness(150%);
            border: 2px solid red;
        }

        [name="champion_grid_item"]:disabled + img {
            filter: grayscale(100%);
        }

        .player-window__blue > .player-window__inner {
            box-shadow: 0 5px 3px 0 rgba(0, 166, 244,0.75);
        }

        .player-window__red > .player-window__inner {
            box-shadow: 0 5px 3px 0 rgba(193, 0, 7,0.75);
        }

        @keyframes currentPhaseBlue {
            0% {
                box-shadow: 0 0 15px 2px rgba(0, 166, 244, .75) inset;
            }
            50% {
                box-shadow: 0 0 15px 7px rgba(0, 166, 244, .75) inset;
            }
            100% {
                box-shadow: 0 0 15px 2px rgba(0, 166, 244, .75) inset;
            }
        }

        @keyframes currentPhaseRed {
            0% {
                box-shadow: 0 0 15px 2px rgba(193, 0, 7, 0.75) inset;
            }
            50% {
                box-shadow: 0 0 15px 7px rgba(193, 0, 7, 0.75) inset;
            }
            100% {
                box-shadow: 0 0 15px 2px rgba(193, 0, 7, 0.75) inset;
            }
        }

        .current-phase {
            position: relative;
            width: 100%;
            height: 100%;
        }
        .current-phase::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 100;
        }
        .current-phase__blue::after {
            animation: currentPhaseBlue 2s infinite ease-in-out;
        }
        .current-phase__red::after {
            animation: currentPhaseRed 2s infinite ease-in-out;
        }
    </style>
{% endblock %}

{% block body %}
    {{ component('Draft', { identifier: draftWithRole.draft.identifier, role: draftWithRole.role }) }}
{% endblock %}
