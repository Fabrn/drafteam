{% extends 'layout.html.twig' %}

{% block main %}
    <h1>{{ 'profile.title' | trans }}</h1>

    <div class="bg-primary/10 p-8 rounded-xl flex flex-col items-center gap-4">
        <img src="{{ user_avatar(app.user) }}" alt="Avatar" width="94" class="rounded-full" />
        <p>{{ app.user.username }}</p>
    </div>

    {% if app.user.waitingDrafts | length > 0 %}
        <div class="overflow-x-auto flex gap-4 mt-8 w-full max-w-full scrollbar-thin scrollbar-track-background scrollbar-thumb-violet-800 pb-2">
            {% for draft in app.user.waitingDrafts %}
                <div class="bg-primary/50 rounded-xl p-4 min-w-1/5 max-w-1/5 text-center">
                    <p class="mb-2 font-bold">{{ draft.name }}</p>
                    <p class="text-xs">{{ 'profile.waiting_drafts.status' | trans }} : {{ draft_status(draft) }}</p>
                    <p class="text-xs">{{ 'profile.waiting_drafts.created_at' | trans }} : {{ draft.createdAt | format_datetime }}</p>
                    <div class="grid grid-cols-2 gap-2 mt-2">
                        <a href="{{ path('draft_view', {
                            _locale: app.request.locale,
                            identifier: draft.identifier,
                            role: draft.spectatorUuid
                        }) }}">
                            <button type="button" class="btn btn-primary w-full flex justify-center">
                                <twig:Icons:Eye size="18" />
                            </button>
                        </a>
                        <button type="button" class="btn bg-red-800 flex justify-center">
                            <twig:Icons:Close size="18" />
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="grid grid-cols-2 gap-8 mt-8">
        {# Finished drafts #}
        {% set finishedDrafts = app.user.createdDrafts | filter(d => not d.isSandbox and d.status is same as enum('App\\Enum\\DraftStatus').Finished) %}

        <div class="bg-primary/10 p-8 rounded-xl flex flex-col gap-4">
            <h2>{{ 'profile.latest_drafts.finished' | trans }}</h2>

            {% if finishedDrafts | length > 0 %}
                <table>
                    <thead>
                    <tr class="border-b-2">
                        <th class="text-center p-2">Name</th>
                        <th class="text-center p-2">Created at</th>
                        <th class="text-center p-2">Status</th>
                        <th class="p-2"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for draft in finishedDrafts %}
                        <tr class="text-sm">
                            <td class="text-center w-1/3 p-2">{{ draft.name }}</td>
                            <td class="text-center p-2">{{ draft.createdAt | format_datetime }}</td>
                            <td class="text-center p-2">{{ draft_status(draft) }}</td>
                            <td class="p-2">
                                <button type="button" class="btn btn-primary">Rejoin</button>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <button type="button" class="block w-full text-sm">
                    {{ 'profile.latest_drafts.view_all' | trans }}
                </button>
            {% else %}
                <p class="italic text-sm opacity-75">
                    {{ 'profile.latest_drafts.none' | trans }}
                </p>
            {% endif %}
        </div>

        {# Sandboxes #}
        {% set sandboxDrafts = app.user.createdDrafts | filter(d => d.isSandbox) %}

        <div class="bg-primary/10 p-8 rounded-xl flex flex-col gap-4">
            <h2>{{ 'profile.latest_drafts.sandboxes' | trans }}</h2>

            {% if sandboxDrafts | length > 0 %}
                <table>
                    <thead>
                    <tr>
                        <th class="p-2">Name</th>
                        <th class="p-2">Created at</th>
                        <th class="p-2"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for draft in sandboxDrafts %}
                        <tr>
                            <td class="w-1/3 text-center p-2">{{ draft.name }}</td>
                            <td class="text-center p-2">{{ draft.createdAt | format_datetime }}</td>
                            <td class="p-2">
                                <a href="{{ path('draft_view', {
                                    _locale: app.request.locale,
                                    identifier: draft.identifier,
                                    role: draft.spectatorUuid
                                }) }}" target="_blank">
                                    <button type="button" class="btn btn-primary">
                                        <twig:Icons:Eye />
                                    </button>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <button type="button" class="block w-full text-sm">
                    {{ 'profile.latest_drafts.view_all' | trans }}
                </button>
            {% else %}
                <p class="italic text-sm opacity-75">
                    {{ 'profile.latest_drafts.none' | trans }}
                </p>
            {% endif %}
        </div>
    </div>
{% endblock %}
