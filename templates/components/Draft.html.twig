<div {{ attributes.defaults(stimulus_controller('hello', { 'url': mercure(draft_mercure_url(this.draft)) })) }} class="h-screen max-h-screen relative">
    {# Ready check screen #}
    {% if not this.draft.redTeamReadyChecked or not this.draft.blueTeamReadyChecked %}
        <div class="fixed top-0 left-0 bg-violet-900/75 text-slate-200 backdrop-blur-md w-screen h-screen z-[100] flex items-center justify-center">
            {% if this.role == enum('App\\Enum\\DraftRole').RedDrafter %}
                {% if this.draft.redTeamReadyChecked %}
                    <p class="text-6xl font-bold">Waiting for ready check</p>
                {% else %}
                    <div class="text-center">
                        <h2 class="text-6xl font-bold mb-8">Ready check</h2>
                        <p class="mb-16">Click this button once your team is ready.</p>
                        <button type="button" class="btn-ready-check bg-red-700 px-12 py-4 rounded-xl text-2xl font-bold cursor-pointer" {{ live_action('readyCheck') }}>
                            Ready !
                        </button>
                    </div>
                {% endif %}
            {% elseif this.role == enum('App\\Enum\\DraftRole').BlueDrafter %}
                {% if this.draft.blueTeamReadyChecked %}
                    <p class="text-6xl font-bold">Waiting for ready check</p>
                {% else %}
                    <div class="text-center">
                        <h2 class="text-6xl font-bold mb-8">Ready check</h2>
                        <p class="mb-16">Click this button once your team is ready.</p>
                        <button type="button" class="btn-ready-check bg-sky-500 px-12 py-4 rounded-xl text-2xl font-bold cursor-pointer" {{ live_action('readyCheck') }}>
                            Ready !
                        </button>
                    </div>
                {% endif %}
            {% else %}
                <p class="text-6xl font-bold">Waiting for ready check</p>
            {% endif %}
        </div>
    {% endif %}

    <header class="flex h-1/8 text-slate-200">
        <div class="bg-sky-500 border-b-8 border-b-sky-900 w-1/4">
            <h2 class="text-2xl font-weight-bold">{{ this.draft.blueTeamName }}</h2>
        </div>
        <div class="w-1/2 flex">
            <div class="bg-slate-900 w-1/8 flex items-center justify-center">
                <p class="text-6xl">{{ this.draft.maxTimer }}</p>
            </div>
            <div class="bg-slate-800 flex items-center justify-center w-6/8">
                <h1 class="text-4xl font-weight-bold">{{ this.draft.name }}</h1>
            </div>
            <div class="bg-slate-900 w-1/8 flex items-center justify-center">
                <p class="text-6xl">{{ this.draft.maxTimer }}</p>
            </div>
        </div>
        <div class="bg-red-700 border-b-8 border-b-red-900 w-1/4">
            <h2 class="text-2xl font-weight-bold">{{ this.draft.redTeamName }}</h2>
        </div>
    </header>
    <main class="flex h-6/8">
        {# Blue side players #}
        <aside class="w-1/4 bg-slate-800 h-full">
            {% for i in 0..4 %}
                <div class="h-1/5">
                    <div class="w-full h-full {{ this.draft.phase.pickPhaseForSide(enum('App\\Enum\\DraftSide').Blue, i + 1) ? 'current-phase current-phase__blue' : '' }}">
                        <div class="player-window player-window__blue relative h-full w-full">
                            {% if this.draft.blueSidePicks[i] is defined %}
                                <img src="{{ lol_champion_splash_image_url(this.draft.blueSidePicks[i].champion.lolId) }}" alt="image" class="w-full h-full object-cover object-[25%_15%]" />
                            {% else %}
                                <div class="w-full h-full bg-none"></div>
                            {% endif %}
                            <div class="player-window__inner absolute top-0 left-0 z-[10] w-full h-full bg-slate-800/25 text-slate-200 uppercase p-8">
                                <p>Player {{ i + 1 }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </aside>
        {# Champion grid #}
        <div class="w-1/2">
            <div class="flex items-center justify-between p-4">
                {# Role filters #}
                <div class="flex">

                </div>
                {# Search bar #}
                <div>
                    <input type="search" class="bg-slate-200" placeholder="Search" data-model="debounce(150)|search" value="{{ this.search }}" />
                </div>
            </div>
            {# Grid #}
            <div class="flex flex-wrap justify-between gap-4 overflow-auto max-h-full px-4 pb-20">
                {% for champion in this.champions %}
                    <label for="champion_grid_item_{{ champion.champion.lolKey }}" class="cursor-pointer">
                        {% if this.role != enum('App\\Enum\\DraftRole').Spectator %}
                            <input type="radio" name="champion_grid_item" id="champion_grid_item_{{ champion.champion.lolKey }}" value="{{ champion.champion.id }}"
                                   {% if not this.draft.championAvailable(champion.champion) or this.draftSide !== this.draft.phase.side %}disabled{% endif %}
                                    class="hidden" />
                        {% endif %}
                        <img src="{{ lol_champion_square_image_url(champion.champion.lolId) }}" alt="{{ champion.name }}'s image" width="96" height="96" />
                    </label>
                {% endfor %}
            </div>
        </div>
        {# Red side players #}
        <aside class="w-1/4 bg-slate-800 h-full">
            {% for i in 0..4 %}
                <div class="h-1/5">
                    <div class="w-full h-full {{ this.draft.phase.pickPhaseForSide(enum('App\\Enum\\DraftSide').Red, i + 1) ? 'current-phase current-phase__red' : '' }}">
                        <div class="player-window player-window__red relative h-full w-full">
                            {% if this.draft.redSidePicks[i] is defined %}
                                <img src="{{ lol_champion_splash_image_url(this.draft.redSidePicks[i].champion.lolId) }}" alt="image" class="w-full h-full object-cover object-[25%_15%]" />
                            {% else %}
                                <div class="w-full h-full bg-none"></div>
                            {% endif %}
                            <div class="player-window__inner absolute top-0 left-0 z-[10] w-full h-full bg-slate-800/25 text-slate-200 uppercase p-8">
                                <p>Player {{ i + 1 }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </aside>
    </main>
    <footer class="flex h-1/8 z-[10] relative text-slate-200">
        {# Blue side bans #}
        <div class="w-1/4 bg-sky-900 px-8 flex items-center justify-center">
            <div class="flex justify-between gap-4">
                {% for i in 0..4 %}
                    <div {% if this.draft.phase.banPhaseForSide(enum('App\\Enum\\DraftSide').Blue, i + 1) %}class="current-phase current-phase__blue"{% endif %}>
                        {% if this.draft.blueSideBans[i] is defined %}
                            <img src="{{ lol_champion_square_image_url(this.draft.blueSideBans[i].champion.lolId) }}" alt="image" width="64" height="64" class="grayscale-100" />
                        {% else %}
                            <div class="w-[64px] h-[64px] bg-sky-950"></div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
        {# Informations #}
        <div class="w-1/2 bg-slate-800 flex items-center justify-center text-slate-200">
            <div>
                {% if this.latestPatch is not null %}
                    <p>Patch {{ this.latestPatch }}</p>
                {% endif %}

                {% if this.draft.status === enum('App\\Enum\\DraftStatus').Ongoing %}
                    <p><strong>Phase courante : {{ this.draft.phase.value }}</strong></p>

                    {% if this.role != enum('App\\Enum\\DraftRole').Spectator %}
                        <button type="button" id="btn-ban" disabled {{ live_action('ban', { id: 0 }) }}>Ban champion</button>
                        <button type="button" id="btn-pick" disabled {{ live_action('pick', { id: 0 }) }}>Pick champion</button>
                    {% endif %}
                {% endif %}

                <p class="text-sm">
                    Your role : {{ this.role == enum('App\\Enum\\DraftRole').BlueDrafter ? 'Bleu team drafter' : (this.role == enum('App\\Enum\\DraftRole').RedDrafter ? 'Rouge team drafter' : 'Spectator') }}
                </p>
            </div>
        </div>
        {# Red side bans #}
        <div class="w-1/4 bg-red-900 px-8 flex items-center justify-center">
            <div class="flex justify-between gap-4">
                {% for i in 0..4 %}
                    <div {% if this.draft.phase.banPhaseForSide(enum('App\\Enum\\DraftSide').Red, i + 1) %}class="current-phase current-phase__red"{% endif %}>
                        {% if this.draft.redSideBans[i] is defined %}
                            <img src="{{ lol_champion_square_image_url(this.draft.redSideBans[i].champion.lolId) }}" alt="image" width="64" height="64" class="grayscale-100" />
                        {% else %}
                            <div class="w-[64px] h-[64px] bg-red-950"></div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </footer>
</div>
