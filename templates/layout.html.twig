{% extends 'base.html.twig' %}

{% block body %}
    <div class="h-screen w-screen grid grid-cols-[300px_1fr] overflow-x-hidden">
        <aside class="shadow-r shadow-xl flex flex-col justify-between h-full bg-sidebar p-6">
            <div>
                {% if app.user is not null %}
                    <a href="{{ path('profile_index', { _locale: app.request.locale }) }}" class="relative bg-primary/50 p-4 flex items-center justify-center gap-4 rounded-xl">
                        {% if app.user.waitingDrafts | length > 0 %}
                            <p class="absolute -top-[5px] -right-[5px] bg-red-800 rounded-full w-[20px] h-[20px] text-xs flex items-center justify-center">
                                {{ app.user.waitingDrafts | length }}
                            </p>
                        {% endif %}

                        <img src="{{ user_avatar(app.user) }}" alt="Avatar" width="32" class="rounded-full" />
                        <p>{{ app.user.username }}</p>
                    </a>
                {% else %}
                    <div class="bg-primary/50 p-4 flex items-center justify-center gap-4 rounded-xl">
                        <twig:Icons:User />
                        <p>Anonymous User</p>
                    </div>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <div>
                        <h3>Admin</h3>
                    </div>
                {% endif %}
            </div>

            <div class="flex flex-col items-center gap-2">
                <a href="{{ path('draft_create', { _locale: app.request.locale }) }}" class="block w-full">
                    <button type="button" class="btn btn-primary w-full flex items-center gap-2 justify-center">
                        <twig:Icons:Plus /> {{ 'draft.create.title' | trans }}
                    </button>
                </a>

                {% if app.user is not null %}
                    <a href="{{ path('auth_logout') }}" class="block w-full">
                        <button type="button" class="btn bg-primary/10 w-full">
                            {{ 'auth.disconnect' | trans }}
                        </button>
                    </a>
                {% else %}
                    <a href="{{ path('auth_discord_start') }}" class="block w-full">
                        <button type="button" class="btn bg-discord w-full">
                            {{ 'auth.discord' | trans }}
                        </button>
                    </a>
                {% endif %}

                <div class="flex gap-2">
                    {% for lang in app.enabled_locales %}
                        <img src="{{ asset('flags/' ~ lang ~ '.svg') }}" alt="{{ lang }}" width="32" />
                    {% endfor %}
                </div>
            </div>
        </aside>
        <main class="p-12 max-h-screen overflow-y-auto">
            {% block main %}{% endblock %}
        </main>
    </div>
{% endblock %}
